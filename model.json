{
  "kind": "openai_realtime_stt",
  "title": "OpenAI Realtime STT",
  "version": "0.1.0",
  "bloxsmith_compatibility": ["1.0.9"],
  "tested_with_bloxsmith": "1.0.9",
  "ports": {
    "inputs": [
      {
        "id": 1, "name": "audio_in", "title": "Audio in",
        "accepts": ["audio/*"], "multiplicity": "one",
        "required": false, "execution_requirement": "not_required_for_execution",
        "transport": "audio_stream",
        "audio_stream": {
          "codecs": ["opus", "aac"], "sample_rates_hz": [], "channels": [1, 2],
          "overflow_policy": "disconnect"
        }
      },
      {
        "id": 2, "name": "command_in", "title": "Command in",
        "accepts": ["application/json"], "multiplicity": "one",
        "required": true, "execution_requirement": "required_for_execution",
        "transport": "message"
      }
    ],
    "outputs": [
      {"id": 1, "name": "partial_out", "title": "Texte provisoire", "emits": ["text/plain", "message/*"], "multiplicity": "many", "transport": "message"},
      {"id": 2, "name": "final_out", "title": "Texte final", "emits": ["text/plain", "message/*"], "multiplicity": "many", "transport": "message"}
    ]
  },
  "config": {
    "api_key_ref": "",
    "model": "gpt-live-transcribe",
    "languages": "fr",
    "prompt": "",
    "delay": "low",
    "segmentation": "duration",
    "segment_seconds": 15,
    "drain_timeout_sec": 5,
    "final_timeout_sec": 20,
    "connect_timeout_sec": 10,
    "max_duration_sec": 3600
  },
  "port_capabilities": {
    "can_add_inputs": false, "can_add_outputs": false,
    "allow_required_input": false, "default_required": false,
    "max_inputs": 2, "max_outputs": 2,
    "default_input_accepts": ["application/json"], "default_output_emits": ["text/plain"],
    "default_multiplicity": "one"
  },
  "runtime": {
    "initial_state": "waiting", "runtime_executable": true, "active_worker": true,
    "generic_source": false, "centralized_executor": "generic",
    "supports_runtime_audio_streams": true, "active_execution_policy": "all_inputs_ready"
  }
}
